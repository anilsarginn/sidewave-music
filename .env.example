# Copy to .env before running Docker Compose. Never commit .env.
PORT=4444
BIND_ADDRESS=0.0.0.0
TZ=UTC
# Set the exact HTTPS origin when using a reverse proxy (no trailing slash).
# MUSIC_PUBLIC_ORIGIN=https://music.example.com
MUSIC_PUBLIC_ORIGIN=

# Optional local music library. Empty folders are supported.
MUSIC_LIBRARY_PATH=./library
NAVIDROME_URL=http://navidrome:4533
NAVIDROME_PORT=4533
NAVIDROME_USER=
NAVIDROME_PASS=

# Archive ingestion is optional and disabled in the default installation.
ARCHIVE_DISABLED=1
SLSKD_URL=
SLSKD_API_KEY=

# Optional sound-analysis services; see docs/self-hosting.md.
ONLINE_SONIC_URL=
SONIC_NAVIDROME_URL=
AUDIOMUSE_URL=
AUDIOMUSE_TOKEN=

# Optional: SHA-256 of YOUR Android release signing certificate, lowercase hex.
# With no certificate and no release metadata, updates remain unavailable.
ANDROID_CERTIFICATE_SHA256=
